{
  "name": "Scheduled Data Sync Scenario",
  "version": 1,
  "modules": [
    {
      "id": 1,
      "module": "cron:ScheduleTrigger",
      "version": 1,
      "parameters": {
        "expression": "0 */6 * * *"
      }
    },
    {
      "id": 2,
      "module": "http:ActionMakeRequest",
      "version": 1,
      "parameters": {
        "url": "https://api.source-crm.com/v1/customers/delta",
        "method": "GET"
      }
    },
    {
      "id": 3,
      "module": "http:ActionMakeRequest",
      "version": 1,
      "parameters": {
        "url": "https://api.target-db.com/v1/sync",
        "method": "POST"
      }
    }
  ]
}
